# Sui Network Configuration
SUI_NETWORK=testnet
SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Solver Wallet Configuration
SOLVER_PRIVATE_KEY=your_solver_private_key_here
SOLVER_PUBLIC_KEY=your_solver_public_key_here

# Intenus Protocol Configuration
INTENUS_PACKAGE_ID=0x993c7635b44582e9c47c589c759239d3e1ce787811af5bfa0056aa253caa394a

# Server Configuration
PORT=3000

# Polling Configuration (milliseconds)
EVENT_POLL_INTERVAL=5000

# Solver Configuration
SOLVER_NAME=SimpleSwapSolver
SOLVER_MIN_PROFIT=0.001
